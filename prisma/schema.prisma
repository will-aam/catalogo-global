generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProdutoGlobal {
  id               Int             @id @default(autoincrement())
  codigo_barras    String          @unique
  descricao        String          @db.VarChar(255)
  
  // Informações Fiscais e de Agrupamento globais
  ncm              String?         @db.VarChar(10)
  categoria        String?         @db.VarChar(100)
  subcategoria     String?         @db.VarChar(100)
  
  marca            String?         @db.VarChar(100)

  // Metadados para Auditoria e Organização das planilhas
  origem_dado      String?         @db.VarChar(100) 
  status_auditoria StatusAuditoria @default(PENDENTE)
  notas_internas   String?         @db.Text
  historicos       HistoricoClassificacao[]

  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  @@index([categoria])
  @@index([subcategoria]) // <-- ÍNDICE PARA DEIXAR A API RÁPIDA
  @@index([status_auditoria])
  @@map("produtos_globais")
}

model HistoricoClassificacao {
  id                 Int                 @id @default(autoincrement())
  produto_id         Int
  codigo_barras      String
  descricao          String              @db.VarChar(255)
  origem             OrigemClassificacao
  ncm_anterior       String?             @db.VarChar(10)
  categoria_anterior String?             @db.VarChar(100)
  subcategoria_anterior String?          @db.VarChar(100)
  marca_anterior     String?             @db.VarChar(100)
  ncm                String?             @db.VarChar(10)
  categoria          String?             @db.VarChar(100)
  subcategoria       String?             @db.VarChar(100)
  marca              String?             @db.VarChar(100)
  confirmou_ncm      Boolean             @default(false)
  confirmou_categoria Boolean            @default(false)
  confirmou_subcategoria Boolean          @default(false)
  confirmou_marca    Boolean             @default(false)
  criado_em          DateTime            @default(now())
  produto            ProdutoGlobal       @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@index([produto_id, criado_em])
  @@index([criado_em])
  @@map("historico_classificacao")
}

model GroqRequestLog {
  id                    Int             @id @default(autoincrement())
  requestId             String          @unique @map("request_id")
  createdAt             DateTime        @map("created_at")
  statusCode            Int             @map("status_code")
  model                 String          @db.VarChar(120)
  timeToFirstToken      Float?          @map("time_to_first_token")
  timeToCompletion      Float?          @map("time_to_completion")
  inputTokens           Int             @default(0) @map("input_tokens")
  inputNonCachedTokens  Int             @default(0) @map("input_non_cached_tokens")
  inputCachedTokens     Int             @default(0) @map("input_cached_tokens")
  inputAudioSeconds     Float           @default(0) @map("input_audio_seconds")
  outputTokens          Int             @default(0) @map("output_tokens")
  errorCode             String?         @map("error_code") @db.VarChar(120)
  errorMessage          String?         @map("error_message") @db.VarChar(500)
  origin                OrigemLogIA     @default(SISTEMA)

  @@index([createdAt])
  @@index([statusCode, createdAt])
  @@map("groq_api_usage")
}

// Adicionar ao final do schema.prisma, antes dos @@map:

model NCM {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique
  descricao  String
  criado_em  DateTime @default(now())

  @@index([codigo])
  @@index([descricao])
  @@map("tabela_ncm")
}

enum StatusAuditoria {
  PENDENTE
  REVISADO
  REJEITADO
}

enum OrigemClassificacao {
  MANUAL
  IA
  LOTE
}

enum OrigemLogIA {
  IMPORTACAO
  SISTEMA
}
